{
  "name": "Bigasan Inventory",
  "short_name": "Bigasan",
  "description": "Rice stock for the Stall and the Bodega",
  "id": "./",
  "start_url": "./#dashboard",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F3F5F0",
  "theme_color": "#1D6A4A",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Record sale", "short_name": "Sell", "url": "./#stock-out", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stock in", "url": "./#stock-in", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Transfer", "url": "./#transfer", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
